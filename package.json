{
  "name": "soundboard-live",
  "version": "1.1.0",
  "description": "Soundboard Live - sound effects app (desktop + web)",
  "main": "main.js",
  "author": "You",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.soundboard.prostudio",
    "productName": "Soundboard Live",
    "publish": null,
    "files": [
      "index.html",
      "main.js",
      "media/**/*",
      "build/icon.png"
    ],
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.entertainment"
    }
  }
}
